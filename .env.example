# Copy this file to .env.local and fill in real values before running the app.
# See README.md "Getting Started" for account setup links.

# Clerk (https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# MongoDB (https://cloud.mongodb.com)
MONGODB_URI=

# Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Public base URL used for Stripe checkout redirects
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Optional: enables the POST /api/dev/seed demo-data endpoint (leave unset to disable).
# After Railway deploy: curl -X POST "https://<app>.up.railway.app/api/dev/seed" -H "x-seed-secret: $SEED_SECRET"
SEED_SECRET=
